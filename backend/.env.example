# Copy this file to .env and fill in your values
PORT=3000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/addressbook
# MongoDB Atlas (Part 6 / Part 8):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/addressbook?retryWrites=true&w=majority

# Allowed frontend origins (comma separated). Use * while developing.
CORS_ORIGIN=*
